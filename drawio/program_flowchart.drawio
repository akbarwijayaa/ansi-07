  <diagram name="Flowchart" id="diag1">
    <mxGraphModel dx="800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v_start" value="Mulai" style="rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1B5E20;fontSize=13;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="110" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v_p1" value="Input bobot W[1..7]&lt;br&gt;dari preferensi pengunjung" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="180" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v_d1" value="∑W[i] = 1.00 ?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7F6000;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="210" y="250" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v_err" value="Tampilkan error,&lt;br&gt;kembali input" style="shape=mxgraph.flowchart.display;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#B71C1C;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="265" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_p2" value="Ambil data evaluasi E[i][j]&lt;br&gt;dari database (10 CS x 7 kriteria)" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="345" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v_loop1" value="FOR i = 1 TO 10 (setiap CS)" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4A148C;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="415" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_init" value="totalWE[i] = 0" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="210" y="475" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="v_loop2" value="FOR j = 1 TO 7 (setiap kriteria)" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7F6000;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="530" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="v_calc" value="WE[i][j] = W[j] x E[i][j]&lt;br&gt;totalWE[i] += WE[i][j]" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1B5E20;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="585" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v_endloop2" value="END FOR j" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7F6000;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="650" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v_endloop1" value="END FOR i" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4A148C;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="695" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v_sort" value="Sorting totalWE[] DESC&lt;br&gt;(tertinggi ke terendah)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="745" width="260" height="40" as="geometry" />
