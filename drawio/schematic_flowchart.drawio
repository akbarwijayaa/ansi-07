        <mxCell id="v_step_title" value="Alur Skenario Penggunaan" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#1e1e1e;fontSize=14;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v_s1" value="1. Pengunjung mengakses website&lt;br&gt;via browser, server me-render landing page" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="305" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v_s2" value="2. Pengunjung login,&lt;br&gt;backend memvalidasi ke database" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="305" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v_s3" value="3. Server query data user dan&lt;br&gt;tampilkan dashboard pengunjung" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="305" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v_s4" value="4. Admin: input data Coffee Shop,&lt;br&gt;kriteria, dan nilai evaluasi via form" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7F6000;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="385" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v_s5" value="5. Pengunjung input bobot&lt;br&gt;preferensi (W) untuk 7 kriteria" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#B71C1C;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="385" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v_s6" value="6. Backend memproses MFEP:&lt;br&gt;ambil W dan E dari DB&lt;br&gt;hitung WE = W x E, totalWE, ranking" style="shape=mxgraph.flowchart.predefined_process;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1B5E20;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="465" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="v_s7" value="7. Response JSON dikirim ke browser,&lt;br&gt;UI menampilkan ranking ke pengunjung" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="555" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v_s8" value="8. Hasil ranking disimpan ke DB&lt;br&gt;sebagai riwayat rekomendasi" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#212121;fontSize=11;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
