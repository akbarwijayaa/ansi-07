      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user_pc" value="🖥️ Komputer /&lt;br&gt;📱 Smartphone&lt;br&gt;(Browser Web)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="128" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="server" value="🌐 Web Server&lt;br&gt;(Vercel)&lt;br&gt;Next.js + Nest.js" style="rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4A148C;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="123" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db" value="🗄️ Database Server&lt;br&gt;(Neon.db)&lt;br&gt;PostgreSQL" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#212121;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="123" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="1. Pengunjung membuka&lt;br&gt;web browser → Landing Page" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="248" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="2. Login / Register&lt;br&gt;→ Server memvalidasi" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="248" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="3. Server query data user&lt;br&gt;dari database → Dashboard" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="248" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="4. Admin: input data CS,&lt;br&gt;kriteria, evaluasi via form" style="rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7F6000;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="338" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="5. Pengunjung: input bobot&lt;br&gt;preferensi 7 kriteria" style="rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#B71C1C;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="338" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step6" value="6. Server memproses MFEP:&lt;br&gt;→ Ambil W &amp; E dari database&lt;br&gt;→ Hitung WE = W × E → ∑WE → Ranking" style="shape=process;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1B5E20;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="428" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="step7" value="7. Server mengirim response&lt;br&gt;→ Browser menampilkan&lt;br&gt;hasil ranking ke layar pengguna" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0D47A1;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="518" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="step8" value="8. Hasil disimpan ke database&lt;br&gt;untuk riwayat rekomendasi" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#212121;fontSize=12;strokeWidth=2;shadow=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
